# OpenAI 兼容接口配置。复制为 .env 后填写真实值，不要提交 .env。
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 可选：使用不同于待评测模型的标注模型；留空时沿用 LLM_MODEL。
ANNOTATION_MODEL=

# OpenAI 官方接口留空；其他兼容服务填写其 /v1 地址。
LLM_BASE_URL=

# 百炼 Qwen 结构化输出：关闭思考并使用 JSON Mode。
LLM_ENABLE_THINKING=false

# 可选：function_calling、json_schema、json_mode。
LLM_STRUCTURED_METHOD=json_mode
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# JSON/Schema 校验失败后，向模型反馈错误并定向重试的次数。
LLM_SCHEMA_MAX_RETRIES=3

# Langfuse Trace。留空时 Knowledge Agent 仍可运行，但不上传 Trace。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1.0

# Knowledge Agent 配置。
KNOWLEDGE_AGENT_MAX_TOOL_ITERATIONS=3
KNOWLEDGE_AGENT_GRAPHRAG_TIMEOUT_SECONDS=180
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=
